# MindShift Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# APPLICATION
# ====================
APP_NAME=MindShift
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ====================
# API KEYS (REQUIRED)
# ====================
# OpenAI API key for GPT-4 (primary AI coach model)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key for Claude (fallback model)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Pinecone API key for vector database (optional, for advanced memory)
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=

# ====================
# DATABASE
# ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://mindshift:mindshift_dev_password@localhost:5432/mindshift

# Redis connection string
REDIS_URL=redis://localhost:6379

# ====================
# SECURITY (IMPORTANT!)
# ====================
# JWT secret for token signing (must be secure in production!)
# Generate with: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_change_in_production_use_64_chars_minimum

# Algorithm for JWT
JWT_ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption key for sensitive data (must be 32 characters)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=dev_encryption_key_32_characters

# ====================
# AI COACH SETTINGS
# ====================
# Primary AI model (gpt-4-turbo-preview recommended)
AI_MODEL_PRIMARY=gpt-4-turbo-preview

# Fallback model if primary fails
AI_MODEL_FALLBACK=claude-3-sonnet-20240229

# AI response temperature (0.0-1.0, higher = more creative)
AI_TEMPERATURE=0.7

# Maximum tokens per response
AI_MAX_TOKENS=1000

# Maximum conversation history to keep in memory
MAX_CONVERSATION_HISTORY=50

# ====================
# VOICE SETTINGS
# ====================
# Enable voice chat feature
ENABLE_VOICE=true

# Whisper model for speech-to-text (tiny, base, small, medium, large)
WHISPER_MODEL=base

# ====================
# CRISIS DETECTION
# ====================
# Enable crisis keyword detection
ENABLE_CRISIS_DETECTION=true

# Minimum crisis keywords to trigger alert
CRISIS_KEYWORDS_THRESHOLD=3

# Crisis hotline number
CRISIS_HOTLINE=988

# Email for crisis escalation
ESCALATION_EMAIL=crisis@mindshift.ai

# ====================
# BURNOUT DETECTION
# ====================
# Path to trained burnout ML model
BURNOUT_MODEL_PATH=./ml_models/burnout_model.pkl

# How often to run predictions (in seconds)
# 86400 = 24 hours
BURNOUT_PREDICTION_INTERVAL=86400

# Score threshold for high-risk alert (0-100)
BURNOUT_HIGH_RISK_THRESHOLD=75

# ====================
# ANALYTICS & PRIVACY
# ====================
# Minimum group size for aggregated analytics (GDPR/privacy)
ANALYTICS_AGGREGATION_MINIMUM=5

# Enable differential privacy for analytics
ENABLE_DIFFERENTIAL_PRIVACY=true

# Data retention period in days
DATA_RETENTION_DAYS=90

# ====================
# INTEGRATIONS
# ====================
# Slack integration
ENABLE_SLACK_INTEGRATION=false
SLACK_WEBHOOK_URL=

# Microsoft Teams integration
ENABLE_TEAMS_INTEGRATION=false

# ====================
# MONITORING
# ====================
# Sentry DSN for error tracking
# Get from: https://sentry.io/
SENTRY_DSN=

# Enable Prometheus metrics endpoint
ENABLE_PROMETHEUS=true

# ====================
# RATE LIMITING
# ====================
# Maximum API requests per user per minute
RATE_LIMIT_PER_MINUTE=60

# ====================
# CORS
# ====================
# Allowed origins for CORS (comma-separated)
# In production, set to your actual domains
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ====================
# EMAIL (for notifications)
# ====================
# SMTP settings (optional, for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mindshift.ai

# ====================
# FEATURE FLAGS
# ====================
# Enable/disable features for gradual rollout
ENABLE_MANAGER_DASHBOARD=true
ENABLE_TEAM_ANALYTICS=true
ENABLE_INTERVENTIONS=true

# ====================
# DEVELOPMENT
# ====================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable SQL query logging
SQL_ECHO=false

# Enable hot reload for development
HOT_RELOAD=true

# ====================
# NOTES
# ====================
# 1. Never commit this file with real credentials
# 2. Use strong, unique values for JWT_SECRET and ENCRYPTION_KEY in production
# 3. Enable HTTPS in production
# 4. Rotate API keys regularly
# 5. Use secrets management (AWS Secrets Manager, etc.) in production
